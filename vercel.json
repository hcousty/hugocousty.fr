{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "redirects": [
    {
      "source": "/agences-suisse",
      "destination": "/agences/",
      "permanent": true
    },
    {
      "source": "/agences-suisse/:path*",
      "destination": "/agences/",
      "permanent": true
    }
  ]
}
